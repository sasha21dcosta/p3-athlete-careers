# P3 Sports — proposed Apache rules for static TanStack build
# DO NOT upload until production backup + staging verification.
# Rename to `.htaccess` in the site document root when ready.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteOptions inherit

  # Canonical host (adjust if apex vs www policy differs)
  # RewriteCond %{HTTP_HOST} ^p3-sports\.com$ [NC]
  # RewriteRule ^ https://www.p3-sports.com%{REQUEST_URI} [R=301,L]

  # Trailing slash for extensionless routes (serves /about/index.html)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !/$
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteRule ^(.+)$ /$1/ [R=301,L]

  # In-app redirect (was /circle route)
  RewriteRule ^circle/?$ / [R=301,L]

  # --- Legacy static site (enable after cutover; tune against FTP listing) ---
  # RewriteRule ^index\.html$ / [R=301,L]
  # RewriteRule ^register\.html$ /contact/ [R=301,L]
  # RewriteRule ^registertournament\.html$ /tournaments/ [R=301,L]
  # RewriteRule ^page([0-9a-f]+)\.html$ / [R=302,L]

  # Optional: keep old uploaded media without moving files
  # RewriteRule ^admin/uploads/(.*)$ /admin/uploads/$1 [L]
</IfModule>

DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType text/javascript .mjs
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|woff|jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>